# Copy to .env.local and fill in real values. Never commit .env.local.
#
#   node setup-env.mjs <service-account.json> [web-config.txt]   # fills Firebase vars
#   node check-auth-config.mjs                                   # verifies without printing secrets
#   node deploy-indexes.mjs --status                             # Firestore index state

# ---------------------------------------------------------------------------
# PUBLIC / client-safe. These are inlined into the browser bundle by Next.js.
# Never put a private key or server API key behind a NEXT_PUBLIC_ name.
#
# In particular there is deliberately no NEXT_PUBLIC_ key for Gemini. The voice
# interview authenticates with a short-lived, single-use token minted per
# session by /api/live-token, so the permanent key never reaches a browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Firebase console > Project settings > General > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# SERVER ONLY. Never expose these to the browser.
# ---------------------------------------------------------------------------

# aistudio.google.com/apikey
# Used for three things, all server-side: generating the interview's topic
# guide, scoring the transcript into feedback, and minting the ephemeral tokens
# the browser uses to open a Live voice session.
GOOGLE_GENERATIVE_AI_API_KEY=

# OPTIONAL model overrides. Google retires preview models on its own schedule --
# the original gemini-2.0-flash-001 pin started answering 404 mid-project -- so
# these exist to make the next retirement a one-line change. Check what is
# actually served with:
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
#
# The realtime voice model. Must be a Live-capable model.
# Defaults to gemini-3.1-flash-live-preview.
# GOOGLE_GENERATIVE_AI_LIVE_MODEL=gemini-3.1-flash-live-preview
#
# The text model used for question generation and feedback scoring. Deliberately
# a different, cheaper tier than the live model. Defaults to gemini-2.5-flash.
# GOOGLE_GENERATIVE_AI_FEEDBACK_MODEL=gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Firebase console > Project settings > Service accounts > Generate new private key.
# FIREBASE_PRIVATE_KEY must be double-quoted with literal \n escapes, e.g.
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# setup-env.mjs writes this correctly; hand-editing it usually breaks the PEM.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# E2E TESTS ONLY (optional). Used by the Playwright suite to sign in as a real
# account without going through the password form: the test harness mints a
# Firebase session cookie with the Admin SDK above. Set this to the uid of an
# existing test user, or leave it unset and the browser tests will skip the
# signed-in specs.
# ---------------------------------------------------------------------------
E2E_TEST_USER_UID=
